<Window x:Class="OsEventEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OsEventEngine"
        mc:Ignorable="d"
        Title="OS esemény Mock View" Height="420" Width="640">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold"
                   Text="Aktuális értékek (csak olvasható; a csúszkák az M6-ban jönnek)" />
        <TextBlock x:Name="LastEventText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontFamily="Consolas" />
        <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="13" />
    </DockPanel>
</Window>
