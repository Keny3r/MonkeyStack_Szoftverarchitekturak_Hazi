<UserControl x:Class="ConfigurationEngine.View.Tabs.CharacterTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:ConfigurationEngine.View.Tabs"
             xmlns:controls="clr-namespace:ConfigurationEngine.View.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=tabs:CharacterTabViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="/ConfigurationEngine;component/View/Styles.xaml" />
    </UserControl.Resources>

    <!-- A „Karakter” fül (gui.md, "1. Karakter mérete" és "2. Mozgási animációk") -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- 1. Karakter mérete: „Méret: [100] × [100] px”, a mozgási animációk fölött -->
            <Grid DataContext="{Binding Size}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Méret:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Width="56" VerticalAlignment="Center"
                         Text="{Binding Width.Text, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static tabs:CharacterSizeViewModel.RangeText}"
                         controls:FocusTarget.Property="CharacterWidth" />
                <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Grid.Column="3" Width="56" VerticalAlignment="Center"
                         Text="{Binding Height.Text, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static tabs:CharacterSizeViewModel.RangeText}"
                         controls:FocusTarget.Property="CharacterHeight" />
                <TextBlock Grid.Column="4" Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />

                <!-- A hibaüzenet a mező alatt -->
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                           Style="{StaticResource FieldErrorText}" Text="{Binding Width.ErrorText}" />
                <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
                           Style="{StaticResource FieldErrorText}" Text="{Binding Height.ErrorText}" />

                <!-- A karakter beállítások egészére vonatkozó hibák -->
                <ItemsControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" ItemsSource="{Binding ItemErrors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource FieldErrorText}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 2. Mozgási animációk: „── Mozgási animációk ──” -->
            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Separator Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Mozgási animációk" Margin="6,0" />
                <Separator Grid.Column="2" VerticalAlignment="Center" />
            </Grid>

            <!-- Mozgásállapotonként egy fix sor: állapot, forrás, sebesség, előnézet -->
            <ItemsControl ItemsSource="{Binding MovementRows}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type tabs:MovementRowViewModel}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="State" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Speed" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- A hibás sor hibajele -->
                            <TextBlock Grid.Column="0" Text="⚠" Foreground="{StaticResource ErrorBrush}"
                                       VerticalAlignment="Center" ToolTip="A sor hibás."
                                       Visibility="{Binding HasAnyError, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Column="1" Text="{Binding StateName}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding DataContext.SourceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding AnimationSourceId}"
                                          controls:FocusTarget.Property="AnimationSourceId" />
                                <TextBlock Style="{StaticResource FieldErrorText}" Text="{Binding FieldErrors[AnimationSourceId]}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="48"
                                             Text="{Binding FramesPerSecond.Text, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static tabs:MovementRowViewModel.FramesPerSecondRangeText}"
                                             controls:FocusTarget.Property="FramesPerSecond" />
                                    <TextBlock Text="fps" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource FieldErrorText}" MaxWidth="160"
                                           Text="{Binding FramesPerSecond.ErrorText}" />
                            </StackPanel>

                            <!-- Élő előnézet: a listák soraiban kicsinyítve -->
                            <controls:AnimationPreview Grid.Column="4" Preview="{Binding Preview}" IsCompact="True" />

                            <!-- A sor egészére vonatkozó hibák -->
                            <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" ItemsSource="{Binding ItemErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource FieldErrorText}" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
