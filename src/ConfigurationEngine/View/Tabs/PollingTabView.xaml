<UserControl x:Class="ConfigurationEngine.View.Tabs.PollingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:ConfigurationEngine.View.Tabs"
             xmlns:controls="clr-namespace:ConfigurationEngine.View.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=tabs:PollingTabViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="/ConfigurationEngine;component/View/Styles.xaml" />
    </UserControl.Resources>

    <!-- A „Mintavételezés” fül (gui.md, "5. Mintavételezés") -->
    <DockPanel Margin="12">
        <!-- [Alapértékek visszaállítása] -->
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="10,2"
                Content="Alapértékek visszaállítása" Command="{Binding ResetDefaultsCommand}" />

        <!-- Metrika | Engedélyezve | Gyakoriság | Szabályok: metrikánként egy fix sor -->
        <ListView ItemsSource="{Binding Rows}" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Metrika" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type tabs:PollingRowViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <!-- A hibás sor hibajele -->
                                    <TextBlock Text="⚠ " Foreground="{StaticResource ErrorBrush}" ToolTip="A sor hibás."
                                               Visibility="{Binding HasAnyError, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding MetricLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Engedélyezve" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type tabs:PollingRowViewModel}">
                                <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                          controls:FocusTarget.Property="IsEnabled" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Gyakoriság" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type tabs:PollingRowViewModel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Kikapcsolt metrikánál inaktív, de az értéke megmarad -->
                                        <TextBox Width="64" Text="{Binding IntervalMs.Text, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsEnabled}"
                                                 ToolTip="{x:Static tabs:PollingRowViewModel.IntervalRangeText}"
                                                 controls:FocusTarget.Property="IntervalMs" />
                                        <TextBlock Text="ms" Margin="4,3,8,0" />
                                        <TextBlock Text="{Binding ReadableInterval}" Foreground="Gray" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FieldErrorText}" MaxWidth="210" Text="{Binding IntervalMs.ErrorText}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Szabályok" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type tabs:PollingRowViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <!-- Kikapcsolt metrikát szabály használ: ezek a szabályok így sosem teljesülnek -->
                                    <TextBlock Text="⚠ " Foreground="#B8860B" ToolTip="{Binding UnreachableRulesToolTip}"
                                               Visibility="{Binding HasUnreachableRules, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding RulesText}" ToolTip="{Binding RulesText}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
