<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A konfigurációs ablak közös stílusai (gui.md, "Mezőnkénti hibajelzés"). -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

    <!-- A hibás mező alatti hibaüzenet; üres szövegnél nem foglal helyet. -->
    <Style x:Key="FieldErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A hibás mező piros keretét a WPF alapértelmezett hibasablonja adja (INotifyDataErrorInfo). -->
</ResourceDictionary>
